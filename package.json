{
    "name": "bravoback",
    "version": "1.0.0",
    "description": "Backend do sistema Bravo Instalações",
    "main": "dist/index.js",
    "scripts": {
        "start-dev": "nodemon --exec ts-node --files src/index.ts",
        "start-staging": "cross-env NODE_ENV=staging nodemon --exec ts-node --files src/index.ts",
        "start-prod": "cross-env NODE_ENV=production npm start",
        "heroku-postbuild": "npm run build",
        "build": "tsc && npm run sanity-check",
        "sanity-check": "ts-node src/scripts/sanityCheck.ts",
        "start": "node dist/index.js",
        "db:clear": "ts-node --files src/scripts/clearAllDatabases.ts",
        "db:init": "ts-node --files src/scripts/InitialBravoDb.ts",
        "db:seed": "ts-node --files src/scripts/InitialBravoDb.ts",
        "seed": "ts-node --files src/scripts/InitialBravoDb.ts",
        "seed:help": "ts-node --files src/scripts/seedHelpScript.ts",
        "export:help": "ts-node --files src/scripts/exportHelpScript.ts",
        "test": "echo \"No tests specified\" && exit 0",
        "cleanup": "ts-node cleanup.ts && git fetch --prune",
        "test:push": "ts-node src/scripts/testPush.ts",
        "git:clean": "git checkout main && git fetch -p && git branch | Select-String -NotMatch 'main|staging' | % { git branch -D $_.ToString().Trim() }",
        "agent:validate": "npx ts-node --project .agents/tsconfig.scripts.json .agents/skills/skill-orchestrator/scripts/validate-skills.ts",
        "agent:fix": "npx ts-node --project .agents/tsconfig.scripts.json .agents/skills/skill-orchestrator/scripts/fix-skills.ts",
        "agent:audit": "npx ts-node --project .agents/tsconfig.scripts.json .agents/skills/skill-orchestrator/scripts/check-contradictions.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cloudinary": "^2.10.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-fileupload": "^1.5.2",
        "express-validator": "^7.3.2",
        "firebase-admin": "^14.1.0",
        "mercadopago": "^3.2.0",
        "mongoose": "^8.5.1",
        "multer": "^2.2.0",
        "node-cron": "^4.6.0",
        "nodemailer": "^9.0.3",
        "nodemailer-sendgrid-transport": "^0.2.0",
        "redis": "^6.1.0",
        "stripe": "^22.3.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.5.3"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/express-fileupload": "^1.5.1",
        "@types/multer": "^2.2.0",
        "@types/node": "^20.14.10",
        "@types/nodemailer": "^8.0.1",
        "nodemon": "^3.1.4"
    }
}
